# demo: no external requests; openai: real structured model calls
AI_PROVIDER=demo
OPENAI_API_KEY=
# Set a model supporting Responses structured outputs when enabling openai.
OPENAI_MODEL=gpt-6-luna
# Blank: omit reasoning.effort (model default). "none": explicitly disable reasoning.
# Supported effort values depend on OPENAI_MODEL. Restart the server/CLI after editing.
OPENAI_REASONING_EFFORT=none
DATABASE_PATH=data/game.sqlite3
